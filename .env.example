# Copie este arquivo para ".env" no servidor e preencha.
# O .env NÃO vai para o GitHub (está no .gitignore). Não use espaços nem aspas nos valores.

NODE_ENV=production
PORT=3000

# Login do painel da chef
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-por-uma-senha-forte

# Uma frase longa e aleatória qualquer (protege o login e o carrinho)
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Dados da loja (opcional: se não preencher, usa o que está em config/loja.js)
# LOJA_NOME=Doceria da Chef
# LOJA_WHATSAPP=5518999999999
# LOJA_INSTAGRAM=doceriadachef
# LOJA_PIX=sua-chave-pix
# LOJA_ANTECEDENCIA_ENCOMENDA=2
# Endereço do site para a prévia do link (se vazio, usa https://DUCKDNS_SUBDOMINIO.duckdns.org)
# LOJA_URL=https://doceriadachef.duckdns.org

# Endereço grátis do DuckDNS (só a parte antes de .duckdns.org) e o token da sua conta lá
DUCKDNS_SUBDOMINIO=doceriadachef
DUCKDNS_TOKEN=cole-o-token-do-duckdns-aqui
