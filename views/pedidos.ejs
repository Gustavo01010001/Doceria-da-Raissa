<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos - Doceria</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
    <link rel="stylesheet" href="/css/admin-tema.css">
    <%- include('partials/tema-inicial') %>

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-title { margin-bottom: 28px; }
        .page-title h1 { margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px; }
        .page-title p { margin: 4px 0 0 0; color: var(--text-muted); font-size: 14px; }

        h2 {
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        h2 i { color: var(--brand-color); font-size: 20px; }

        .caixa {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
        }

        /* Próximas encomendas, agrupadas por dia */
        .agenda { margin-bottom: 36px; }
        .agenda-dia + .agenda-dia { border-top: 1px solid var(--border-color); margin-top: 12px; padding-top: 12px; }
        .agenda-data { font-weight: 600; font-size: 14px; margin-bottom: 6px; }
        .agenda-data small { color: var(--text-muted); font-weight: 500; margin-left: 6px; }
        .agenda-pedido { font-size: 14px; color: var(--text-muted); padding: 3px 0; }
        .agenda-pedido strong { color: var(--text-main); font-weight: 600; }

        /* Total a produzir no dia, somando todos os pedidos */
        .producao {
            background: var(--superficie-suave);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 8px;
            font-size: 14px;
        }
        .producao-titulo { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 4px; }
        .producao ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }
        .producao strong { color: var(--brand-color); }

        /* Filtro por status */
        .filtros { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .filtro {
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-muted);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
        }
        .filtro:hover { border-color: var(--borda-forte); color: var(--text-main); }
        .filtro.ativo { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-texto); }

        .lista-pedidos { display: flex; flex-direction: column; gap: 12px; }

        .pedido-topo {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 12px;
        }
        .pedido-topo h3 { margin: 0; font-size: 15px; font-weight: 600; }
        .pedido-topo small { color: var(--text-muted); font-size: 13px; }

        .itens { list-style: none; margin: 0 0 12px; padding: 0; font-size: 14px; }
        .itens li { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
        .itens li span:last-child { color: var(--text-muted); white-space: nowrap; }
        .itens .total { border-top: 1px solid var(--border-color); margin-top: 4px; padding-top: 8px; font-weight: 700; }
        .itens .total span:last-child { color: var(--text-main); }

        .detalhes { font-size: 13px; color: var(--text-muted); display: grid; gap: 4px; margin-bottom: 14px; }
        .detalhes i { margin-right: 4px; }
        .detalhes strong { color: var(--text-main); font-weight: 600; }

        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }
        .badge.novo { background: var(--rosa-suave); color: var(--rosa-texto); }
        .badge.preparo { border: 1px solid var(--brand-color); color: var(--brand-color); }
        .badge.entregue { background: var(--verde-bg); color: var(--verde-texto); }
        .badge.cancelado { background: var(--superficie-suave); color: var(--text-muted); }

        .acoes { display: flex; gap: 8px; flex-wrap: wrap; border-top: 1px solid var(--border-color); padding-top: 12px; }
        form { margin: 0; }

        .btn-action {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 14px;
            border-radius: 6px;
            font-family: inherit;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .btn-action:hover { background: var(--superficie-suave); border-color: var(--borda-forte); }
        .btn-action.cancelar { color: var(--danger-text); border-color: transparent; background: transparent; }
        .btn-action.cancelar:hover { background: var(--danger-hover); }

        .vazio {
            text-align: center;
            padding: 48px 20px;
            border: 1px dashed var(--border-color);
            border-radius: 12px;
            background: var(--card-bg);
            color: var(--text-muted);
            font-size: 14px;
        }
        .vazio i { font-size: 40px; display: block; margin-bottom: 12px; }

        @media (max-width: 640px) {
            .container { margin: 24px auto; padding: 0 16px; }
            .acoes form { flex: 1; }
            .acoes .btn-action { width: 100%; justify-content: center; padding: 10px; }
        }
    </style>
</head>
<body>

    <%- include('partials/admin-topo', { ativa: 'pedidos' }) %>

    <div class="container">

        <div class="page-title">
            <h1>Pedidos</h1>
            <p>Os pedidos enviados pelo WhatsApp ficam guardados aqui</p>
        </div>

        <% const datas = Object.keys(encomendasPorData); %>
        <% if (datas.length > 0) { %>
            <section class="agenda">
                <h2><i class="ph-bold ph-calendar-heart"></i> Próximas encomendas</h2>
                <div class="caixa">
                    <% datas.forEach(data => { %>
                        <div class="agenda-dia">
                            <div class="agenda-data">
                                <%= formatarData(data) %>
                                <small><%= new Date(data + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'long', timeZone: 'UTC' }) %></small>
                            </div>
                            <div class="producao">
                                <div class="producao-titulo">Para fazer</div>
                                <ul>
                                    <% encomendasPorData[data].producao.forEach(item => { %>
                                        <li><strong><%= item.quantidade %>x</strong> <%= item.nome %></li>
                                    <% }) %>
                                </ul>
                            </div>
                            <% encomendasPorData[data].pedidos.forEach(pedido => { %>
                                <div class="agenda-pedido">
                                    <strong><%= pedido.nome %>:</strong>
                                    <%= pedido.itens.filter(item => item.tipo === 'encomenda').map(item => item.quantidade + 'x ' + item.nome).join(', ') %>
                                    <span class="badge <%= pedido.status %>"><%= statusPedido[pedido.status] %></span>
                                </div>
                            <% }) %>
                        </div>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <h2><i class="ph-bold ph-receipt"></i> Todos os pedidos</h2>

        <nav class="filtros">
            <a href="/admin/pedidos" class="filtro <%= filtro ? '' : 'ativo' %>">Todos</a>
            <% Object.entries(statusPedido).forEach(([chave, nome]) => { %>
                <a href="/admin/pedidos?status=<%= chave %>" class="filtro <%= filtro === chave ? 'ativo' : '' %>"><%= nome %> (<%= contagem[chave] || 0 %>)</a>
            <% }) %>
        </nav>

        <div class="lista-pedidos">
            <% if (pedidos.length > 0) { %>
                <% pedidos.forEach(pedido => { %>
                    <div class="caixa">
                        <div class="pedido-topo">
                            <div>
                                <h3>#<%= pedido.id %> · <%= pedido.nome %></h3>
                                <small><%= formatarDataHora(pedido.criado_em) %></small>
                            </div>
                            <span class="badge <%= pedido.status %>"><%= statusPedido[pedido.status] %></span>
                        </div>

                        <ul class="itens">
                            <% pedido.itens.forEach(item => { %>
                                <li>
                                    <span><%= item.quantidade %>x <%= item.nome %><%= item.tipo === 'encomenda' ? ' (encomenda)' : '' %></span>
                                    <span><%= formatarPreco(item.preco * item.quantidade) %></span>
                                </li>
                            <% }) %>
                            <li class="total"><span>Total</span><span><%= formatarPreco(pedido.total) %></span></li>
                        </ul>

                        <div class="detalhes">
                            <% if (pedido.entrega === 'entrega') { %>
                                <div><i class="ph ph-moped"></i> Entrega: <strong><%= pedido.endereco %></strong></div>
                            <% } else { %>
                                <div><i class="ph ph-storefront"></i> Vai retirar no local</div>
                            <% } %>
                            <% if (pedido.data_encomenda) { %>
                                <div><i class="ph ph-calendar"></i> Encomenda para <strong><%= formatarData(pedido.data_encomenda) %></strong></div>
                            <% } %>
                            <div><i class="ph ph-wallet"></i> Pagamento: <strong><%= pedido.pagamento %></strong></div>
                            <% if (pedido.observacoes) { %>
                                <div><i class="ph ph-note"></i> <%= pedido.observacoes %></div>
                            <% } %>
                        </div>

                        <div class="acoes">
                            <% Object.entries(statusPedido).filter(([chave]) => chave !== pedido.status).forEach(([chave, nome]) => { %>
                                <form action="/admin/pedidos/status" method="POST" <%- chave === 'cancelado' ? `onsubmit="return confirm('Cancelar o pedido #${pedido.id}?');"` : '' %>>
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="id" value="<%= pedido.id %>">
                                    <input type="hidden" name="status" value="<%= chave %>">
                                    <input type="hidden" name="filtro" value="<%= filtro || '' %>">
                                    <button type="submit" class="btn-action <%= chave === 'cancelado' ? 'cancelar' : '' %>">
                                        <%= chave === 'cancelado' ? 'Cancelar' : nome %>
                                    </button>
                                </form>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="vazio">
                    <i class="ph ph-receipt"></i>
                    <%= filtro ? 'Nenhum pedido com esse status.' : 'Nenhum pedido ainda. Eles aparecem aqui quando um cliente envia o pedido pelo WhatsApp.' %>
                </div>
            <% } %>
        </div>

    </div>

</body>
</html>
