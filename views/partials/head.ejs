<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#ffb6c1">
<script>
    // Aplica o tema escolhido antes de desenhar a página (evita piscar branco no modo escuro)
    try {
        const tema = localStorage.getItem('tema');
        if (tema === 'claro' || tema === 'escuro') document.documentElement.dataset.tema = tema;
    } catch (erro) {}
</script>
<title><%= titulo %></title>
<meta name="description" content="<%= loja.slogan %>">

<!-- Prévia do link quando compartilhado (Instagram, WhatsApp...) -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= loja.nome %>">
<meta property="og:description" content="<%= loja.slogan %>">
<meta property="og:url" content="<%= urlBase %>">
<% if (typeof imagemPrevia !== 'undefined' && imagemPrevia) { %>
<meta property="og:image" content="<%= urlBase + imagemPrevia %>">
<% } %>

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧁</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
<script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
<link rel="stylesheet" href="/css/loja.css">
