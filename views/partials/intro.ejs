<%#
    Intro animada de entrada (abre uma vez por visita: fechou a aba e voltou, aparece de novo).
    Não aparece com "reduzir movimento" ligado nem no modo leve (aparelho fraco).
    Toque ou qualquer tecla pula a intro. Uso: include('partials/intro', { chave: 'loja', subtitulo: '...' })

    Roteiro (~4 s):
      0,0 s  brilhos de açúcar vêm de todos os lados até o centro
      0,5 s  dois anéis de luz se desenham girando
      1,15 s flash + raios + onda dupla + granulado + cupcake pulando
      1,6 s  letras do nome caem uma por uma; depois uma faixa de luz passa
      2,4 s  subtítulo se abre e a linha de "carregando" corre
      2,95 s o fundo escuro some e o cupcake e o nome VOAM até o logo e o título da loja
             (no painel, que não tem esse logo, eles crescem e somem)

    Otimização: tudo o que se mexe usa só transform e opacity (o celular faz isso na placa de
    vídeo, sem redesenhar a tela). Nada de blur, máscara animada ou sombra animada.
%>
<% const chaveIntro = 'intro-' + (typeof chave !== 'undefined' ? chave : 'loja'); %>
<script>
    try {
        const raiz = document.documentElement;
        const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!semMovimento && !raiz.dataset.leve && !sessionStorage.getItem('<%= chaveIntro %>')) {
            raiz.dataset.intro = 'sim';
            sessionStorage.setItem('<%= chaveIntro %>', '1');
        }
    } catch (erro) {}
</script>

<% if (typeof fonteNome !== 'undefined' && fonteNome) { %>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap&text=<%= encodeURIComponent(loja.nome) %>" rel="stylesheet">
<% } %>

<style>
    .intro { display: none; }
    :root[data-intro] { overflow: hidden; }
    /* A loja fica escondida embaixo e aparece no fim (quem anima é o script) */
    :root[data-intro] body > :not(.intro) { opacity: 0; }

    :root[data-intro] .intro {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 14vh;
        color: #fff;
        cursor: pointer;
        overflow: hidden;
        contain: strict; /* o que acontece aqui dentro não mexe no resto da página */
        /* "Relógio" invisível: quando termina, o script começa a saída. Assim a saída anda junto
           com as outras animações, mesmo num celular lento ou com a aba aberta em segundo plano. */
        animation: intro-relogio 2.95s linear;
    }

    @keyframes intro-relogio { to { opacity: 1; } }

    .intro-fundo {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 50% 40%, rgba(216, 27, 96, 0.28) 0%, transparent 45%),
            radial-gradient(circle at 50% 42%, #3b1526 0%, #1c0d14 55%, #0b0608 100%);
    }

    /* Raios de luz girando atrás do emblema */
    .intro-raios {
        position: absolute;
        left: 50%;
        top: 40%;
        width: 130vmax;
        height: 130vmax;
        margin: -65vmax 0 0 -65vmax;
        background: repeating-conic-gradient(from 0deg, rgba(255, 182, 193, 0.16) 0deg 6deg, transparent 6deg 22deg);
        -webkit-mask-image: radial-gradient(circle, #000 0%, transparent 45%);
        mask-image: radial-gradient(circle, #000 0%, transparent 45%);
        opacity: 0;
        animation: intro-aparecer 0.8s ease-out 1.15s forwards, intro-girar 16s linear infinite;
    }

    /* Clarão no momento da explosão */
    .intro-flash {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 182, 193, 0.5) 25%, transparent 60%);
        opacity: 0;
        animation: intro-flash 0.55s ease-out 1.12s forwards;
    }

    /* Brilhos de açúcar que se juntam no centro */
    .intro-brilho {
        position: absolute;
        left: 50%;
        top: 40%;
        width: 6px;
        height: 6px;
        margin: -3px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 10px 2px rgba(255, 182, 193, 0.9);
        opacity: 0;
        animation: intro-juntar 1s cubic-bezier(.55, 0, .9, .4) var(--atraso) forwards;
    }

    .intro-palco {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .intro-emblema {
        position: relative;
        width: 140px;
        height: 140px;
        display: grid;
        place-items: center;
    }

    .intro-anel {
        position: absolute;
        inset: 0;
        overflow: visible;
        animation: intro-girar 2.4s linear infinite;
    }

    .intro-anel.de-volta { animation-direction: reverse; animation-duration: 3.4s; }
    .intro-anel circle { fill: none; stroke-linecap: round; }

    .intro-anel .anel-1 {
        stroke: #f06292;
        stroke-width: 5;
        stroke-dasharray: 402;
        stroke-dashoffset: 402;
        filter: drop-shadow(0 0 8px rgba(240, 98, 146, 0.95));
        animation: intro-desenhar 0.7s cubic-bezier(.65, 0, .35, 1) 0.5s forwards;
    }

    .intro-anel .anel-2 {
        stroke: rgba(255, 193, 211, 0.75);
        stroke-width: 2;
        stroke-dasharray: 3 11;
        opacity: 0;
        animation: intro-aparecer 0.6s ease-out 0.75s forwards;
    }

    .intro-miolo {
        position: relative;
        width: 112px;
        height: 112px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #ff9cbd, #d81b60 70%);
        box-shadow: 0 0 46px rgba(240, 98, 146, 0.7), inset 0 -6px 14px rgba(0, 0, 0, 0.25);
        display: grid;
        place-items: center;
        font-size: 58px;
        scale: 0;
        rotate: -14deg;
        animation: intro-pulo 0.7s cubic-bezier(.34, 1.7, .64, 1) 1.15s forwards;
    }

    /* Brilho que "respira" em volta (só opacidade: não redesenha a sombra) */
    .intro-miolo::before {
        content: '';
        position: absolute;
        inset: -18px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(240, 98, 146, 0.55) 40%, transparent 70%);
        z-index: -1;
        opacity: 0;
        animation: intro-respirar 1.6s ease-in-out 1.9s infinite;
    }

    /* Reflexo que passa pelo cupcake, como vidro */
    .intro-reflexo {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        overflow: hidden;
    }

    .intro-reflexo::after {
        content: '';
        position: absolute;
        inset: -20% auto -20% 0;
        width: 40%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
        rotate: 20deg;
        translate: -150% 0;
        animation: intro-reflexo 0.9s ease-in-out 1.95s forwards;
    }

    .intro-onda {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 3px solid rgba(255, 182, 193, 0.9);
        opacity: 0;
        animation: intro-onda 1s ease-out 1.15s forwards;
    }

    .intro-onda.segunda { border-width: 1.5px; animation-delay: 1.32s; animation-duration: 1.2s; }

    .intro-granulado {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 13px;
        height: 4px;
        margin: -2px 0 0 -6px;
        border-radius: 4px;
        background: var(--cor);
        opacity: 0;
        rotate: var(--angulo);
        animation: intro-granulado 1.1s cubic-bezier(.15, .8, .3, 1) 1.15s forwards;
    }

    .intro-nome {
        position: relative;
        margin: 8px 0 0;
        font-family: 'Pacifico', 'Nunito', cursive;
        font-weight: 400;
        font-size: clamp(30px, 9vw, 48px);
        line-height: 1.3;
        text-align: center;
        white-space: nowrap;
    }

    .intro-letra {
        display: inline-block;
        white-space: pre;
        text-shadow: 0 0 18px rgba(240, 98, 146, 0.8);
        opacity: 0;
        translate: 0 -30px;
        scale: 1.5;
        animation: intro-letra 0.55s cubic-bezier(.3, 1.6, .5, 1) calc(1.6s + var(--i) * 0.045s) forwards;
    }

    /* Faixa de luz que cruza o nome */
    .intro-nome::after {
        content: '';
        position: absolute;
        top: -20%;
        bottom: -20%;
        left: 0;
        width: 35%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
        transform: skewX(-20deg);
        opacity: 0;
        animation: intro-faixa 0.9s ease-in-out 2.3s forwards;
    }

    .intro-sub {
        margin: 0;
        font-family: 'Nunito', 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: #ffc1d3;
        opacity: 0;
        scale: 1.25 1;
        animation: intro-sub 0.8s cubic-bezier(.2, .8, .3, 1) 2.4s forwards;
    }

    /* Linha de "carregando" com um brilho correndo */
    .intro-linha {
        position: relative;
        width: 140px;
        height: 2px;
        margin-top: 6px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.15);
        overflow: hidden;
        scale: 0 1;
        animation: intro-linha 0.6s cubic-bezier(.2, .8, .3, 1) 2.45s forwards;
    }

    .intro-linha::after {
        content: '';
        position: absolute;
        inset: 0;
        width: 50%;
        background: linear-gradient(90deg, transparent, #ff8fb4, transparent);
        translate: -100% 0;
        animation: intro-correr 0.9s ease-in-out 2.6s infinite;
    }

    .intro-pular {
        position: absolute;
        bottom: calc(22px + env(safe-area-inset-bottom, 0px));
        font: 600 12px 'Nunito', 'Segoe UI', sans-serif;
        color: rgba(255, 255, 255, 0.72);
        opacity: 0;
        animation: intro-aparecer 0.4s ease-out 0.8s forwards;
    }

    @keyframes intro-juntar {
        0% { opacity: 0; transform: translate(var(--x), var(--y)) scale(1.4); }
        25% { opacity: 1; }
        100% { opacity: 1; transform: translate(0, 0) scale(0.2); }
    }
    @keyframes intro-desenhar { to { stroke-dashoffset: 0; } }
    @keyframes intro-aparecer { to { opacity: 1; } }
    @keyframes intro-girar { to { rotate: 360deg; } }
    @keyframes intro-flash { 0% { opacity: 0; } 25% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes intro-pulo { to { scale: 1; rotate: 0deg; } }
    @keyframes intro-respirar { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
    @keyframes intro-reflexo { to { translate: 350% 0; } }
    @keyframes intro-onda {
        0% { opacity: 1; scale: 0.9; }
        100% { opacity: 0; scale: 3.2; }
    }
    @keyframes intro-granulado {
        0% { opacity: 1; transform: translateX(30px) rotate(0deg); }
        75% { opacity: 1; }
        100% { opacity: 0; transform: translateX(var(--distancia)) rotate(200deg); }
    }
    @keyframes intro-letra { to { opacity: 1; translate: 0 0; scale: 1; } }
    @keyframes intro-faixa {
        0% { opacity: 0; translate: -120% 0; }
        15%, 80% { opacity: 1; }
        100% { opacity: 0; translate: 320% 0; }
    }
    @keyframes intro-sub { to { opacity: 1; scale: 1 1; } }
    @keyframes intro-linha { to { scale: 1 1; } }
    @keyframes intro-correr { to { translate: 200% 0; } }
</style>

<div class="intro" id="intro" aria-hidden="true">
    <div class="intro-fundo"></div>
    <div class="intro-raios intro-enfeite"></div>
    <% for (let i = 0; i < 18; i++) {
        const angulo = i * 20 + (i % 2) * 9;
        const raio = 170 + (i % 4) * 45;
        const x = Math.round(Math.cos(angulo * Math.PI / 180) * raio);
        const y = Math.round(Math.sin(angulo * Math.PI / 180) * raio); %>
        <span class="intro-brilho intro-enfeite" style="--x: <%= x %>px; --y: <%= y %>px; --atraso: <%= ((i * 7) % 18) * 0.025 %>s"></span>
    <% } %>
    <div class="intro-flash"></div>

    <div class="intro-palco">
        <div class="intro-emblema">
            <svg class="intro-anel intro-enfeite" viewBox="0 0 140 140"><circle class="anel-1" cx="70" cy="70" r="64"/></svg>
            <svg class="intro-anel de-volta intro-enfeite" viewBox="0 0 140 140"><circle class="anel-2" cx="70" cy="70" r="76"/></svg>
            <span class="intro-onda"></span>
            <span class="intro-onda segunda"></span>
            <% ['#ffb6c1', '#fff176', '#80deea', '#ce93d8', '#a5d6a7', '#ffffff', '#ff8a65', '#f06292', '#90caf9', '#ffe082', '#b39ddb', '#ffab91',
                '#fff176', '#f06292', '#80deea', '#ffffff', '#ce93d8', '#ffe082']
                .forEach((cor, i) => { %>
                <span class="intro-granulado" style="--cor: <%= cor %>; --angulo: <%= i * 20 + 5 %>deg; --distancia: <%= 130 + (i % 4) * 35 %>px"></span>
            <% }) %>
            <div class="intro-miolo">🧁<span class="intro-reflexo"></span></div>
        </div>
        <p class="intro-nome" aria-label="<%= loja.nome %>"><span class="intro-nome-texto"><% [...loja.nome].forEach((letra, i) => { %><span class="intro-letra" style="--i: <%= i %>"><%= letra %></span><% }) %></span></p>
        <% if (typeof subtitulo !== 'undefined' && subtitulo) { %>
            <p class="intro-sub intro-enfeite"><%= subtitulo %></p>
        <% } %>
        <span class="intro-linha intro-enfeite"></span>
    </div>
    <span class="intro-pular intro-enfeite">Toque para pular</span>
</div>

<script>
    (() => {
        const raiz = document.documentElement;
        const intro = document.getElementById('intro');
        if (!intro) return;
        // Já viu nesta visita (ou aparelho fraco / reduzir movimento): tira a intro da página
        if (!raiz.dataset.intro) return intro.remove();

        const suave = 'cubic-bezier(.65, 0, .25, 1)';
        const animacoes = [];
        let terminou = false;
        let saindo = false;

        function animar(elemento, quadros, opcoes) {
            if (!elemento || !elemento.animate) return;
            animacoes.push(elemento.animate(quadros, { fill: 'forwards', ...opcoes }));
        }

        // Partes da loja que entram no fim (tudo o que está no body, menos a própria intro)
        function partesDaLoja() {
            return [...document.body.children].filter(el => el !== intro && !['SCRIPT', 'STYLE', 'LINK'].includes(el.tagName));
        }

        function terminar() {
            if (terminou) return;
            terminou = true;
            delete raiz.dataset.intro;
            animacoes.forEach(animacao => animacao.cancel());
            intro.remove();
            document.removeEventListener('keydown', pular);
        }

        function pular() {
            if (terminou || saindo) return;
            saindo = true;
            intro.style.pointerEvents = 'none';
            partesDaLoja().forEach(parte => animar(parte, [{ opacity: 0 }, { opacity: 1 }], { duration: 250 }));
            animar(intro, [{ opacity: 1 }, { opacity: 0 }], { duration: 250 });
            setTimeout(terminar, 270);
        }

        // Centro de um retângulo
        const centro = (r) => ({ x: r.left + r.width / 2, y: r.top + r.height / 2 });

        function sair() {
            if (terminou || saindo) return;
            saindo = true;
            const emblema = intro.querySelector('.intro-emblema');
            const nome = intro.querySelector('.intro-nome');
            const textoDoNome = intro.querySelector('.intro-nome-texto');
            const palco = intro.querySelector('.intro-palco');

            // Para onde voar: o logo 🧁 e o título da loja (só existem na vitrine)
            const logo = document.querySelector('.topo-logo');
            const titulo = document.querySelector('.topo h1');
            let voo = null;
            if (logo && titulo) {
                const rLogo = logo.getBoundingClientRect();
                const faixa = document.createRange();
                faixa.selectNodeContents(titulo);
                const rTitulo = faixa.getBoundingClientRect();
                const rEmblema = emblema.getBoundingClientRect();
                const rNome = textoDoNome.getBoundingClientRect();
                if (rLogo.bottom > 0 && rTitulo.bottom > 0 && rTitulo.top < innerHeight && rNome.width > 0) {
                    const a = centro(rEmblema), b = centro(rLogo), c = centro(rNome), d = centro(rTitulo);
                    voo = {
                        emblema: `translate(${b.x - a.x}px, ${b.y - a.y}px) scale(${rLogo.width / 112})`,
                        nome: `translate(${d.x - c.x}px, ${d.y - c.y}px) scale(${rTitulo.width / rNome.width})`
                    };
                }
            }

            // 1) Fundo escuro e enfeites somem
            animar(intro.querySelector('.intro-fundo'), [{ opacity: 1 }, { opacity: 0 }], { duration: 800, easing: 'ease-in-out' });
            intro.querySelectorAll('.intro-enfeite, .intro-flash').forEach(el =>
                animar(el, [{ opacity: getComputedStyle(el).opacity }, { opacity: 0 }], { duration: 300, easing: 'ease-out' }));

            // 2) Cupcake e nome voam até o lugar deles na loja (ou crescem e somem, no painel)
            if (voo) {
                animar(emblema, [{ transform: 'none' }, { transform: voo.emblema }], { duration: 900, easing: suave });
                animar(nome, [{ transform: 'none' }, { transform: voo.nome }], { duration: 900, easing: suave });
                animar(palco, [{ opacity: 1 }, { opacity: 0 }], { duration: 260, delay: 850, easing: 'ease-out' });
            } else {
                animar(palco, [{ transform: 'none', opacity: 1 }, { transform: 'scale(1.12)', opacity: 0 }], { duration: 650, easing: suave });
            }

            // 3) A loja aparece por baixo, subindo de leve
            const atraso = voo ? 500 : 250;
            partesDaLoja().forEach(parte => {
                const sobe = parte.matches('main, .container');
                animar(parte, sobe
                    ? [{ opacity: 0, transform: 'translateY(24px)' }, { opacity: 1, transform: 'none' }]
                    : [{ opacity: 0 }, { opacity: 1 }],
                    { duration: 600, delay: atraso, easing: 'cubic-bezier(.2, .8, .3, 1)' });
            });

            setTimeout(terminar, atraso + 650);
        }

        intro.addEventListener('animationend', (evento) => {
            if (evento.target === intro && evento.animationName === 'intro-relogio') sair();
        });
        intro.addEventListener('click', pular);
        document.addEventListener('keydown', pular);
        // Segurança: se as animações não rodarem por algum motivo, a loja aparece mesmo assim
        setTimeout(terminar, 8000);
    })();
</script>
