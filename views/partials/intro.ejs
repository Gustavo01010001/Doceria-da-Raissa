<%#
    Intro animada de entrada (abre uma vez por visita: fechou a aba e voltou, aparece de novo).
    Não aparece com "reduzir movimento" ligado nem no modo leve (aparelho fraco).
    Toque ou qualquer tecla pula a intro. Uso: include('partials/intro', { chave: 'loja', subtitulo: '...' })

    Roteiro (~3,7 s):
      0,0 s  brilhos de açúcar vêm de todos os lados até o centro
      0,5 s  dois anéis de luz se desenham girando
      1,15 s flash + raios de luz + onda dupla + granulado voando + cupcake pulando
      1,6 s  letras do nome caem uma por uma, depois um brilho passa por cima
      2,4 s  subtítulo aparece se abrindo
      2,95 s um "buraco" de borda esfumada se abre no meio e a loja chega com um leve zoom (1,3 s)
%>
<% const chaveIntro = 'intro-' + (typeof chave !== 'undefined' ? chave : 'loja'); %>
<script>
    try {
        const raiz = document.documentElement;
        const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!semMovimento && !raiz.dataset.leve && !sessionStorage.getItem('<%= chaveIntro %>')) {
            raiz.dataset.intro = 'sim';
            sessionStorage.setItem('<%= chaveIntro %>', '1');
        }
    } catch (erro) {}
</script>

<% if (typeof fonteNome !== 'undefined' && fonteNome) { %>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap&text=<%= encodeURIComponent(loja.nome) %>" rel="stylesheet">
<% } %>

<style>
    @property --furo {
        syntax: '<length>';
        inherits: false;
        initial-value: 0px;
    }

    .intro { display: none; }
    :root[data-intro] { overflow: hidden; }
    :root[data-intro] .intro {
        --centro: 50% 42%;
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding-bottom: 16vh;
        background: radial-gradient(circle at var(--centro), #3b1526 0%, #1c0d14 55%, #0b0608 100%);
        color: #fff;
        cursor: pointer;
        overflow: hidden;
        /* Buraco com borda esfumada: a loja aparece por trás de um jeito suave */
        --furo: -45vmax;
        -webkit-mask-image: radial-gradient(circle at var(--centro), transparent var(--furo), #000 calc(var(--furo) + 40vmax));
        mask-image: radial-gradient(circle at var(--centro), transparent var(--furo), #000 calc(var(--furo) + 40vmax));
        animation: intro-abrir 1.3s cubic-bezier(.45, 0, .2, 1) 2.95s forwards;
    }

    /* A loja por baixo chega com um leve zoom enquanto a intro se abre */
    :root[data-intro] body > header,
    :root[data-intro] body > main,
    :root[data-intro] body > .container,
    :root[data-intro] body > footer {
        animation: intro-site-entrar 1.4s cubic-bezier(.25, .8, .3, 1) 2.95s both;
    }
    @keyframes intro-site-entrar {
        from { opacity: 0.3; scale: 1.06; filter: blur(4px); }
        to { opacity: 1; scale: 1; filter: blur(0); }
    }

    /* Raios de luz girando atrás do emblema */
    .intro-raios {
        position: absolute;
        left: 50%;
        top: 42%;
        width: 160vmax;
        height: 160vmax;
        translate: -50% -50%;
        background: repeating-conic-gradient(from 0deg, rgba(255, 182, 193, 0.16) 0deg 6deg, transparent 6deg 22deg);
        -webkit-mask-image: radial-gradient(circle, #000 0%, transparent 45%);
        mask-image: radial-gradient(circle, #000 0%, transparent 45%);
        opacity: 0;
        animation: intro-raios-acender 0.8s ease-out 1.15s forwards, intro-girar 14s linear infinite;
    }

    /* Clarão branco no momento da explosão */
    .intro-flash {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at var(--centro), rgba(255, 255, 255, 0.95) 0%, rgba(255, 182, 193, 0.5) 25%, transparent 60%);
        opacity: 0;
        pointer-events: none;
        animation: intro-flash 0.55s ease-out 1.12s forwards;
    }

    /* Brilhos de açúcar que se juntam no centro */
    .intro-brilho {
        position: absolute;
        left: 50%;
        top: 42%;
        width: 6px;
        height: 6px;
        margin: -3px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 10px 2px rgba(255, 182, 193, 0.9);
        opacity: 0;
        animation: intro-juntar 1s cubic-bezier(.55, 0, .9, .4) var(--atraso) forwards;
    }

    .intro-palco {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        animation: intro-palco-sair 1s cubic-bezier(.45, 0, .2, 1) 2.9s forwards;
    }

    .intro-emblema {
        position: relative;
        width: 140px;
        height: 140px;
        display: grid;
        place-items: center;
    }

    .intro-anel {
        position: absolute;
        inset: 0;
        overflow: visible;
        animation: intro-girar 2.4s linear infinite;
    }

    .intro-anel circle {
        fill: none;
        stroke-linecap: round;
    }

    .intro-anel .anel-1 {
        stroke: #f06292;
        stroke-width: 5;
        stroke-dasharray: 402;
        stroke-dashoffset: 402;
        filter: drop-shadow(0 0 8px rgba(240, 98, 146, 0.95));
        animation: intro-desenhar 0.7s cubic-bezier(.65, 0, .35, 1) 0.5s forwards;
    }

    .intro-anel.de-volta { animation-direction: reverse; animation-duration: 3.4s; }

    .intro-anel .anel-2 {
        stroke: rgba(255, 193, 211, 0.75);
        stroke-width: 2;
        stroke-dasharray: 3 11;
        opacity: 0;
        animation: intro-aparecer 0.6s ease-out 0.75s forwards;
    }

    .intro-miolo {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #ff9cbd, #d81b60 70%);
        box-shadow: 0 0 46px rgba(240, 98, 146, 0.7), inset 0 -6px 14px rgba(0, 0, 0, 0.25);
        display: grid;
        place-items: center;
        font-size: 58px;
        scale: 0;
        rotate: -14deg;
        animation: intro-pulo 0.7s cubic-bezier(.34, 1.7, .64, 1) 1.15s forwards,
                   intro-respirar 1.6s ease-in-out 1.9s infinite;
    }

    .intro-onda {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 3px solid rgba(255, 182, 193, 0.9);
        opacity: 0;
        animation: intro-onda 1s ease-out 1.15s forwards;
    }

    .intro-onda.segunda { border-width: 1.5px; animation-delay: 1.32s; animation-duration: 1.2s; }

    .intro-granulado {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 13px;
        height: 4px;
        margin: -2px 0 0 -6px;
        border-radius: 4px;
        background: var(--cor);
        opacity: 0;
        rotate: var(--angulo);
        animation: intro-granulado 1.1s cubic-bezier(.15, .8, .3, 1) 1.15s forwards;
    }

    .intro-nome {
        margin: 6px 0 0;
        padding: 0 12px;
        font-family: 'Pacifico', 'Nunito', cursive;
        font-weight: 400;
        font-size: clamp(30px, 9vw, 48px);
        line-height: 1.3;
        text-align: center;
        white-space: nowrap;
        position: relative;
    }

    .intro-letra {
        display: inline-block;
        white-space: pre;
        color: #fff;
        text-shadow: 0 0 18px rgba(240, 98, 146, 0.8);
        opacity: 0;
        translate: 0 -28px;
        scale: 1.4;
        filter: blur(6px);
        animation: intro-letra 0.5s cubic-bezier(.3, 1.5, .5, 1) calc(1.6s + var(--i) * 0.045s) forwards;
    }

    /* Faixa de brilho que passa por cima do nome */
    .intro-nome::after {
        content: '';
        position: absolute;
        inset: -10% 0;
        background: linear-gradient(100deg, transparent 35%, rgba(255, 255, 255, 0.9) 50%, transparent 65%);
        mix-blend-mode: overlay;
        translate: -130% 0;
        animation: intro-faixa 0.9s ease-in-out 2.35s forwards;
    }

    .intro-sub {
        margin: 0;
        font-family: 'Nunito', 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.6em;
        text-transform: uppercase;
        color: #ffc1d3;
        opacity: 0;
        animation: intro-sub 0.8s cubic-bezier(.2, .8, .3, 1) 2.4s forwards;
    }

    .intro-pular {
        position: absolute;
        bottom: calc(22px + env(safe-area-inset-bottom, 0px));
        font: 600 12px 'Nunito', 'Segoe UI', sans-serif;
        color: rgba(255, 255, 255, 0.72);
        opacity: 0;
        animation: intro-aparecer 0.4s ease-out 0.8s forwards;
    }

    /* Pulou a intro: some rápido */
    :root[data-intro] .intro.saindo { animation: intro-sumir 0.25s ease-out forwards; }

    @keyframes intro-juntar {
        0% { opacity: 0; transform: translate(var(--x), var(--y)) scale(1.4); }
        25% { opacity: 1; }
        100% { opacity: 1; transform: translate(0, 0) scale(0.2); }
    }
    @keyframes intro-desenhar { to { stroke-dashoffset: 0; } }
    @keyframes intro-aparecer { to { opacity: 1; } }
    @keyframes intro-girar { to { rotate: 360deg; } }
    @keyframes intro-flash { 0% { opacity: 0; } 25% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes intro-raios-acender { to { opacity: 1; } }
    @keyframes intro-pulo { to { scale: 1; rotate: 0deg; } }
    @keyframes intro-respirar {
        0%, 100% { box-shadow: 0 0 46px rgba(240, 98, 146, 0.7), inset 0 -6px 14px rgba(0, 0, 0, 0.25); }
        50% { box-shadow: 0 0 70px rgba(240, 98, 146, 1), inset 0 -6px 14px rgba(0, 0, 0, 0.25); }
    }
    @keyframes intro-onda {
        0% { opacity: 1; scale: 0.9; }
        100% { opacity: 0; scale: 3.2; }
    }
    @keyframes intro-granulado {
        0% { opacity: 1; transform: translateX(30px) rotate(0deg); }
        75% { opacity: 1; }
        100% { opacity: 0; transform: translateX(var(--distancia)) rotate(200deg); }
    }
    @keyframes intro-letra { to { opacity: 1; translate: 0 0; scale: 1; filter: blur(0); } }
    @keyframes intro-faixa { to { translate: 130% 0; } }
    @keyframes intro-sub { to { opacity: 1; letter-spacing: 0.32em; } }
    @keyframes intro-palco-sair { to { scale: 1.18; opacity: 0; filter: blur(5px); } }
    @keyframes intro-abrir {
        0% { --furo: -45vmax; opacity: 1; }
        70% { opacity: 1; }
        100% { --furo: 150vmax; opacity: 0; visibility: hidden; }
    }
    @keyframes intro-sumir { to { opacity: 0; visibility: hidden; } }
</style>

<div class="intro" id="intro" aria-hidden="true">
    <div class="intro-raios"></div>
    <% for (let i = 0; i < 18; i++) {
        const angulo = i * 20 + (i % 2) * 9;
        const raio = 170 + (i % 4) * 45;
        const x = Math.round(Math.cos(angulo * Math.PI / 180) * raio);
        const y = Math.round(Math.sin(angulo * Math.PI / 180) * raio); %>
        <span class="intro-brilho" style="--x: <%= x %>px; --y: <%= y %>px; --atraso: <%= ((i * 7) % 18) * 0.025 %>s"></span>
    <% } %>
    <div class="intro-flash"></div>

    <div class="intro-palco">
        <div class="intro-emblema">
            <svg class="intro-anel" viewBox="0 0 140 140"><circle class="anel-1" cx="70" cy="70" r="64"/></svg>
            <svg class="intro-anel de-volta" viewBox="0 0 140 140"><circle class="anel-2" cx="70" cy="70" r="76"/></svg>
            <span class="intro-onda"></span>
            <span class="intro-onda segunda"></span>
            <% ['#ffb6c1', '#fff176', '#80deea', '#ce93d8', '#a5d6a7', '#ffffff', '#ff8a65', '#f06292', '#90caf9', '#ffe082', '#b39ddb', '#ffab91',
                '#fff176', '#f06292', '#80deea', '#ffffff', '#ce93d8', '#ffe082']
                .forEach((cor, i) => { %>
                <span class="intro-granulado" style="--cor: <%= cor %>; --angulo: <%= i * 20 + 5 %>deg; --distancia: <%= 130 + (i % 4) * 35 %>px"></span>
            <% }) %>
            <div class="intro-miolo">🧁</div>
        </div>
        <p class="intro-nome" aria-label="<%= loja.nome %>"><% [...loja.nome].forEach((letra, i) => { %><span class="intro-letra" style="--i: <%= i %>"><%= letra %></span><% }) %></p>
        <% if (typeof subtitulo !== 'undefined' && subtitulo) { %>
            <p class="intro-sub"><%= subtitulo %></p>
        <% } %>
    </div>
    <span class="intro-pular">Toque para pular</span>
</div>

<script>
    (() => {
        const raiz = document.documentElement;
        const intro = document.getElementById('intro');
        if (!raiz.dataset.intro || !intro) return;

        let terminou = false;
        function terminar() {
            if (terminou) return;
            terminou = true;
            delete raiz.dataset.intro;
            intro.remove();
            document.removeEventListener('keydown', pular);
        }
        function pular() {
            intro.classList.add('saindo');
            setTimeout(terminar, 260);
        }

        intro.addEventListener('animationend', (evento) => {
            if (evento.target === intro) setTimeout(terminar, 150); // deixa o zoom da loja terminar
        });
        intro.addEventListener('click', pular);
        document.addEventListener('keydown', pular);
        // Segurança: se alguma animação não rodar, a loja aparece mesmo assim
        setTimeout(terminar, 4800);
    })();
</script>
