<script nonce="<%= nonce %>">
    // Aplica o tema escolhido antes de desenhar a página (evita piscar branco no modo escuro)
    try {
        const tema = localStorage.getItem('tema');
        if (tema === 'claro' || tema === 'escuro') document.documentElement.dataset.tema = tema;
    } catch (erro) {}

    // Modo leve: em aparelho com pouca memória (até 2 GB), poucos núcleos ou com economia de dados
    // ligada, o site abre sem sombras e animações, pra rolar liso. O visual quase não muda.
    try {
        const conexao = navigator.connection || {};
        if (navigator.deviceMemory <= 2 || navigator.hardwareConcurrency <= 2 || conexao.saveData) {
            document.documentElement.dataset.leve = 'sim';
        }
    } catch (erro) {}

    // A chuva de granulado do topo da vitrine toca uma vez por visita (a vitrine marca quando já tocou)
    try {
        if (sessionStorage.getItem('granulado-visto')) document.documentElement.dataset.granulado = 'visto';
    } catch (erro) {}

    // Troca de página macia: às vezes o navegador desiste da animação (ex: depois de enviar um
    // formulário). Não é erro, a página só abre sem animar; assim o console não acusa nada.
    function semErroNaTransicao(evento) {
        const transicao = evento.viewTransition;
        if (!transicao) return;
        [transicao.updateCallbackDone, transicao.ready, transicao.finished].forEach(promessa => {
            if (promessa) promessa.catch(() => {});
        });
    }
    window.addEventListener('pageswap', semErroNaTransicao);
    window.addEventListener('pagereveal', semErroNaTransicao);
</script>
