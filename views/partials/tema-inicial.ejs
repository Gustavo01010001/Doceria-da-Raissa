<script nonce="<%= nonce %>">
    // Aplica o tema escolhido antes de desenhar a página (evita piscar branco no modo escuro)
    try {
        const tema = localStorage.getItem('tema');
        if (tema === 'claro' || tema === 'escuro') document.documentElement.dataset.tema = tema;
    } catch (erro) {}

    // Modo leve: em aparelho com pouca memória (até 2 GB), poucos núcleos ou com economia de dados
    // ligada, o site abre sem sombras e animações, pra rolar liso. O visual quase não muda.
    try {
        const conexao = navigator.connection || {};
        if (navigator.deviceMemory <= 2 || navigator.hardwareConcurrency <= 2 || conexao.saveData) {
            document.documentElement.dataset.leve = 'sim';
        }
    } catch (erro) {}
</script>
