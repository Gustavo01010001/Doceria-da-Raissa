<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <% const produtoComFoto = produtos.find(produto => produto.imagem); %>
    <%- include('partials/head', { titulo: loja.nome + ' - Faça seu pedido', imagemPrevia: produtoComFoto && produtoComFoto.imagem }) %>
</head>
<body>
    <%- include('partials/tema') %>

    <header class="topo">
        <div class="topo-logo">🧁</div>
        <h1><%= loja.nome %></h1>
        <p><%= loja.slogan %></p>

        <div class="topo-links">
            <a href="https://wa.me/<%= loja.whatsapp %>" target="_blank" rel="noopener">
                <i class="ph-bold ph-whatsapp-logo"></i> WhatsApp
            </a>
            <% if (loja.instagram) { %>
                <a href="https://instagram.com/<%= loja.instagram %>" target="_blank" rel="noopener">
                    <i class="ph-bold ph-instagram-logo"></i> @<%= loja.instagram %>
                </a>
            <% } %>
        </div>
    </header>

    <% const abas = [
        { id: 'pronta', titulo: 'Pronta entrega', icone: 'ph-lightning', aviso: 'Já está pronto! É só pedir.', vazio: 'Nenhum doce a pronta entrega no momento.' },
        { id: 'encomenda', titulo: 'Encomendas', icone: 'ph-calendar-heart', aviso: `Feitos sob encomenda. Peça com pelo menos ${loja.antecedenciaEncomenda} ${loja.antecedenciaEncomenda === 1 ? 'dia' : 'dias'} de antecedência.`, vazio: 'Nenhum doce sob encomenda no momento.' }
    ]; %>

    <main class="container">
        <% if (pausa.pausada) { %>
            <div class="aviso-pausa" role="status">
                <i class="ph-bold ph-moon-stars"></i>
                <div>
                    <strong>Não estamos aceitando pedidos no momento</strong>
                    <% if (pausa.recado) { %><span><%= pausa.recado %></span><% } %>
                </div>
            </div>
        <% } %>

        <nav class="abas" role="tablist">
            <% abas.forEach(aba => { %>
                <a href="?aba=<%= aba.id %>" class="aba <%= abaAtiva === aba.id ? 'ativa' : '' %>" data-aba="<%= aba.id %>" role="tab" aria-selected="<%= abaAtiva === aba.id %>">
                    <i class="ph-bold <%= aba.icone %>"></i> <%= aba.titulo %>
                    <span class="aba-contador"><%= produtos.filter(produto => produto.tipo === aba.id).length %></span>
                </a>
            <% }) %>
        </nav>

        <% abas.forEach(aba => { %>
        <% const produtosDaAba = produtos.filter(produto => produto.tipo === aba.id); %>
        <% const categoriasDaAba = [...new Set(produtosDaAba.map(produto => produto.categoria).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR')); %>
        <section class="painel-aba" id="aba-<%= aba.id %>" role="tabpanel" <%= abaAtiva === aba.id ? '' : 'hidden' %>>
        <p class="aviso-aba"><i class="ph-bold <%= aba.icone %>"></i> <%= aba.aviso %></p>

        <% if (categoriasDaAba.length > 0) { %>
            <div class="filtros">
                <button type="button" class="filtro ativo" data-categoria="" aria-pressed="true">Todos</button>
                <% categoriasDaAba.forEach(categoria => { %>
                    <button type="button" class="filtro" data-categoria="<%= categoria %>" aria-pressed="false"><%= categoria %></button>
                <% }) %>
            </div>
        <% } %>

        <div class="grid-cardapio">
            <% if (produtosDaAba.length > 0) { %>
                <% produtosDaAba.forEach(function(produto) { %>
                    <div class="produto-card <%= produto.disponivel ? '' : 'esgotado' %>" data-categoria="<%= produto.categoria || '' %>">

                        <div class="produto-foto">
                            <% if (produto.imagem) { %>
                                <img src="<%= produto.imagem %>" alt="<%= produto.nome %>" loading="lazy">
                            <% } else { %>
                                <div class="produto-sem-foto">🍰</div>
                            <% } %>
                            <% if (!produto.disponivel) { %>
                                <span class="selo-esgotado"><%= aba.id === 'encomenda' ? 'Indisponível' : 'Esgotado' %></span>
                            <% } %>
                        </div>

                        <div class="produto-info">
                            <h3><%= produto.nome %></h3>
                            <% if (produto.descricao) { %>
                                <p class="produto-descricao"><%= produto.descricao %></p>
                            <% } %>
                            <p class="produto-preco"><%= formatarPreco(produto.preco) %></p>
                            <% if (produto.disponivel && produto.estoque !== null) { %>
                                <p class="produto-restam"><%= produto.estoque === 1 ? 'Resta 1!' : `Restam ${produto.estoque}` %></p>
                            <% } %>

                            <form action="/carrinho/adicionar" method="POST" class="form-comprar">
                                <input type="hidden" name="produtoId" value="<%= produto.id %>">
                                <% if (pausa.pausada && produto.disponivel) { %>
                                    <button type="button" class="btn-comprar" disabled>Pausado</button>
                                <% } else if (produto.disponivel) { %>
                                    <button type="submit" class="btn-comprar"><i class="ph-bold ph-plus"></i> <%= aba.id === 'encomenda' ? 'Encomendar' : 'Adicionar' %></button>
                                <% } else { %>
                                    <button type="button" class="btn-comprar" disabled><%= aba.id === 'encomenda' ? 'Indisponível' : 'Esgotado' %></button>
                                <% } %>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="vazio">
                    <i class="ph-light ph-cake"></i>
                    <p><%= aba.vazio %></p>
                </div>
            <% } %>
        </div>
        </section>
        <% }) %>
    </main>

    <footer class="rodape">
        © <%= new Date().getFullYear() %> <%= loja.nome %> · <a href="/login">Área da chef</a>
    </footer>

    <div class="barra-carrinho" id="barra-carrinho" <%= quantidadeCarrinho > 0 ? '' : 'hidden' %>>
        <a href="/carrinho">
            <span class="contador">
                <span id="qtd-carrinho"><%= quantidadeCarrinho %></span> Ver carrinho
            </span>
            <span id="total-carrinho"><%= formatarPreco(totalCarrinho) %></span>
        </a>
    </div>

    <div class="aviso" id="aviso" role="status" aria-live="polite"></div>

    <script>
        const barra = document.getElementById('barra-carrinho');
        const aviso = document.getElementById('aviso');
        let timerAviso;

        function mostrarAviso(texto) {
            aviso.textContent = texto;
            aviso.classList.add('visivel');
            clearTimeout(timerAviso);
            timerAviso = setTimeout(() => aviso.classList.remove('visivel'), 2200);
        }

        function atualizarBarra(dados) {
            document.getElementById('qtd-carrinho').textContent = dados.quantidade;
            document.getElementById('total-carrinho').textContent = 'R$ ' + dados.total.toFixed(2).replace('.', ',');
            barra.hidden = dados.quantidade === 0;
            barra.classList.remove('pulo');
            void barra.offsetWidth; // reinicia a animação
            barra.classList.add('pulo');
        }

        // Troca de aba sem recarregar a página (o link ?aba=... continua funcionando)
        document.querySelectorAll('.aba').forEach(aba => {
            aba.addEventListener('click', (evento) => {
                evento.preventDefault();
                document.querySelectorAll('.aba').forEach(outra => {
                    const ativa = outra === aba;
                    outra.classList.toggle('ativa', ativa);
                    outra.setAttribute('aria-selected', ativa);
                    document.getElementById('aba-' + outra.dataset.aba).hidden = !ativa;
                });
                history.replaceState(null, '', '?aba=' + aba.dataset.aba);
            });
        });

        // Filtro por categoria: mostra só os doces da categoria escolhida na aba
        document.querySelectorAll('.filtro').forEach(filtro => {
            filtro.addEventListener('click', () => {
                const painel = filtro.closest('.painel-aba');
                painel.querySelectorAll('.filtro').forEach(outro => {
                    outro.classList.toggle('ativo', outro === filtro);
                    outro.setAttribute('aria-pressed', outro === filtro);
                });
                painel.querySelectorAll('.produto-card').forEach(card => {
                    card.hidden = filtro.dataset.categoria !== '' && card.dataset.categoria !== filtro.dataset.categoria;
                });
            });
        });

        // Adiciona ao carrinho sem sair da página
        document.querySelectorAll('.form-comprar').forEach(form => {
            form.addEventListener('submit', async (evento) => {
                evento.preventDefault();
                const botao = form.querySelector('button');
                botao.disabled = true;
                try {
                    const resposta = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: new URLSearchParams(new FormData(form))
                    });
                    if (!resposta.ok) throw new Error();
                    const dados = await resposta.json();
                    if (dados.ok) {
                        atualizarBarra(dados);
                        mostrarAviso(dados.nome + ' adicionado! 🧁');
                    } else if (dados.motivo === 'limite') {
                        mostrarAviso(`Você já pegou ${dados.estoque === 1 ? 'o último' : 'todos os ' + dados.estoque} 😊`);
                    } else if (dados.motivo === 'pausada') {
                        mostrarAviso('A loja não está aceitando pedidos agora.');
                    } else {
                        mostrarAviso('Ops, esse doce acabou de esgotar 😢');
                    }
                } catch (erro) {
                    mostrarAviso('Não deu certo, tente de novo.');
                } finally {
                    botao.disabled = false;
                }
            });
        });
    </script>

</body>
</html>
