<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head', { titulo: 'Login - Acesso Restrito' }) %>
    <meta name="robots" content="noindex">
</head>
<body>
    <%- include('partials/tema') %>

    <div class="pagina-centro">
        <div class="cartao-centro">
            <div class="emoji">👩‍🍳</div>
            <h2>Área da Chef</h2>

            <% if (erro) { %>
                <div class="erro-msg"><i class="ph-bold ph-warning-circle"></i> <%= erro %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="campo">
                    <label for="usuario">Usuário</label>
                    <input type="text" id="usuario" name="usuario" autocomplete="username" autocapitalize="none" required>
                </div>
                <div class="campo">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" autocomplete="current-password" required>
                </div>
                <button type="submit" class="btn btn-principal">Entrar</button>
            </form>

            <a href="/" class="btn btn-texto"><i class="ph-bold ph-arrow-left"></i> Voltar para a loja</a>
        </div>
    </div>

</body>
</html>
