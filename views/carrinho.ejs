<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head', { titulo: 'Seu Carrinho - ' + loja.nome }) %>
</head>
<body>
    <%- include('partials/tema') %>

    <header class="topo-simples">
        <div class="container">
            <a href="/" class="btn-icone" aria-label="Voltar ao cardápio"><i class="ph-bold ph-arrow-left"></i></a>
            <h1><i class="ph-fill ph-shopping-cart"></i> Seu Carrinho</h1>
        </div>
    </header>

    <main class="carrinho-container">

        <% if (carrinho.length > 0) { %>
            <div class="caixa">
                <% carrinho.forEach(item => { %>
                    <div class="item">
                        <div class="item-foto">
                            <% if (item.imagem) { %>
                                <img src="<%= item.imagem %>" alt="<%= item.nome %>">
                            <% } else { %>
                                🍰
                            <% } %>
                        </div>

                        <div class="item-info">
                            <strong><%= item.nome %><% if (item.tipo === 'encomenda') { %> <span class="selo-encomenda">Encomenda</span><% } %></strong>
                            <small><%= formatarPreco(item.preco) %> cada</small>
                            <form action="/carrinho/quantidade" method="POST" class="quantidade">
                                <input type="hidden" name="produtoId" value="<%= item.id %>">
                                <button type="submit" name="acao" value="menos" aria-label="Diminuir"><i class="ph-bold ph-minus"></i></button>
                                <span class="numero"><%= item.quantidade %></span>
                                <button type="submit" name="acao" value="mais" aria-label="Aumentar"><i class="ph-bold ph-plus"></i></button>
                                <button type="submit" name="acao" value="remover" class="remover" aria-label="Remover"><i class="ph ph-trash"></i></button>
                            </form>
                        </div>

                        <span class="item-subtotal"><%= formatarPreco(item.preco * item.quantidade) %></span>
                    </div>
                <% }) %>

                <div class="total">
                    <span>Total</span>
                    <span><%= formatarPreco(total) %></span>
                </div>
            </div>

            <form action="/carrinho/finalizar" method="POST" id="form-pedido">
                <div class="caixa">
                    <h2><i class="ph-bold ph-user"></i> Seus dados</h2>

                    <% if (erro) { %>
                        <div class="erro-msg"><i class="ph-bold ph-warning-circle"></i> <%= erro %></div>
                    <% } %>

                    <div class="campo">
                        <label for="nome">Seu nome</label>
                        <input type="text" id="nome" name="nome" value="<%= cliente.nome || '' %>" autocomplete="name" required>
                    </div>

                    <div class="campo">
                        <span class="rotulo">Como prefere receber?</span>
                        <div class="opcoes">
                            <label>
                                <input type="radio" name="entrega" value="retirada" <%= cliente.entrega !== 'entrega' ? 'checked' : '' %>>
                                <span><i class="ph ph-storefront"></i> Retirar</span>
                            </label>
                            <label>
                                <input type="radio" name="entrega" value="entrega" <%= cliente.entrega === 'entrega' ? 'checked' : '' %>>
                                <span><i class="ph ph-moped"></i> Entrega</span>
                            </label>
                        </div>
                    </div>

                    <div class="campo" id="campo-endereco" <%= cliente.entrega === 'entrega' ? '' : 'hidden' %>>
                        <label for="endereco">Endereço de entrega</label>
                        <textarea id="endereco" name="endereco" rows="2" placeholder="Rua, número, bairro e complemento" autocomplete="street-address"><%= cliente.endereco || '' %></textarea>
                        <div class="dica">A taxa de entrega é combinada pelo WhatsApp.</div>
                    </div>

                    <% if (temEncomenda) { %>
                        <div class="campo">
                            <label for="dataEncomenda">Para quando é a encomenda?</label>
                            <input type="date" id="dataEncomenda" name="dataEncomenda" value="<%= cliente.dataEncomenda || '' %>" min="<%= dataMinima %>" required>
                            <div class="dica">Encomendas precisam de pelo menos <%= loja.antecedenciaEncomenda %> <%= loja.antecedenciaEncomenda === 1 ? 'dia' : 'dias' %> de antecedência.</div>
                        </div>
                    <% } %>

                    <div class="campo">
                        <span class="rotulo">Forma de pagamento</span>
                        <div class="opcoes">
                            <% pagamentos.forEach(pagamento => { %>
                                <label>
                                    <input type="radio" name="pagamento" value="<%= pagamento %>" <%= cliente.pagamento === pagamento ? 'checked' : '' %> required>
                                    <span><%= pagamento %></span>
                                </label>
                            <% }) %>
                        </div>
                        <% if (loja.pix) { %>
                            <div class="dica" id="dica-pix" <%= cliente.pagamento === 'Pix' ? '' : 'hidden' %>>
                                Chave Pix: <strong id="chave-pix"><%= loja.pix %></strong>
                                <button type="button" class="btn-copiar" id="btn-copiar-pix"><i class="ph-bold ph-copy"></i> Copiar</button>
                                <br>Ela também vai junto na mensagem do pedido.
                            </div>
                        <% } %>
                    </div>

                    <div class="campo">
                        <label for="observacoes">Observações <span style="font-weight: 400; color: var(--cor-texto-suave);">(opcional)</span></label>
                        <textarea id="observacoes" name="observacoes" rows="2" placeholder="Ex: horário de preferência, sem granulado..."><%= cliente.observacoes || '' %></textarea>
                    </div>
                </div>

                <% if (pausa.pausada) { %>
                    <div class="erro-msg">
                        <i class="ph-bold ph-moon-stars"></i>
                        Não estamos aceitando pedidos no momento.<%= pausa.recado ? ' ' + pausa.recado : '' %>
                    </div>
                    <button type="button" class="btn btn-whatsapp" disabled>
                        <i class="ph-bold ph-whatsapp-logo"></i> Pedidos pausados
                    </button>
                <% } else { %>
                    <button type="submit" class="btn btn-whatsapp">
                        <i class="ph-bold ph-whatsapp-logo"></i> Enviar pedido pelo WhatsApp
                    </button>
                <% } %>
            </form>

            <a href="/" class="btn btn-secundario">
                <i class="ph-bold ph-plus"></i> Adicionar mais doces
            </a>

            <form action="/carrinho/esvaziar" method="POST" onsubmit="return confirm('Esvaziar o carrinho?');">
                <button type="submit" class="btn btn-texto">
                    <i class="ph ph-trash"></i> Esvaziar carrinho
                </button>
            </form>

        <% } else { %>
            <div class="carrinho-vazio">
                <i class="ph-light ph-shopping-bag"></i>
                <p>Seu carrinho está vazio.</p>
            </div>

            <a href="/" class="btn btn-principal">
                <i class="ph-bold ph-cake"></i> Ver o cardápio
            </a>
        <% } %>

    </main>

    <script>
        // Mostra o campo de endereço só quando escolher "Entrega"
        const campoEndereco = document.getElementById('campo-endereco');
        document.querySelectorAll('input[name="entrega"]').forEach(opcao => {
            opcao.addEventListener('change', () => {
                const entrega = opcao.value === 'entrega' && opcao.checked;
                campoEndereco.hidden = !entrega;
                document.getElementById('endereco').required = entrega;
            });
        });

        // Mostra a chave Pix só quando escolher Pix
        const dicaPix = document.getElementById('dica-pix');
        if (dicaPix) {
            document.querySelectorAll('input[name="pagamento"]').forEach(opcao => {
                opcao.addEventListener('change', () => {
                    dicaPix.hidden = !(opcao.value === 'Pix' && opcao.checked);
                });
            });

            // Copia a chave Pix com um toque
            const botaoCopiar = document.getElementById('btn-copiar-pix');
            botaoCopiar.addEventListener('click', async () => {
                const chave = document.getElementById('chave-pix').textContent.trim();
                try {
                    await navigator.clipboard.writeText(chave);
                } catch (erro) {
                    // Navegador antigo: copia do jeito antigo
                    const campo = document.createElement('textarea');
                    campo.value = chave;
                    document.body.appendChild(campo);
                    campo.select();
                    document.execCommand('copy');
                    campo.remove();
                }
                botaoCopiar.innerHTML = '<i class="ph-bold ph-check"></i> Copiada!';
                setTimeout(() => { botaoCopiar.innerHTML = '<i class="ph-bold ph-copy"></i> Copiar'; }, 2000);
            });
        }
    </script>

</body>
</html>
